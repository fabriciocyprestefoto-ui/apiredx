# Futebol Brasil API — Variáveis de Ambiente
# Copie para .env e ajuste os valores.
# Nunca commite o arquivo .env.

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development

# ── Cache (TTLs em segundos) ──────────────────────────────────────────────────
TTL_JOGOS=300          # jogos do dia (5 min)
TTL_TABELA=3600        # tabela de classificação (1h)
TTL_ELENCO=86400       # elencos/times (24h)
TTL_TRANSMISSOES=1800  # transmissões/próximos jogos (30 min)

# ── Scrapers ──────────────────────────────────────────────────────────────────
ENABLE_SCRAPERS=true
USER_AGENT="FutebolBrasilAPI/2.0 contato: fabriciocypreste@gmail.com"

# ── Integração com tv-moderno-limpo ──────────────────────────────────────────
# Coloque esta variável no .env do projeto Vite/React:
# VITE_SPORTS_API_URL=http://localhost:3333

# ── APIs Externas (opcionais — ESPN pública não exige chave) ──────────────────
# API-Football (api-football.com) — dados premium de futebol
FOOTBALL_API_KEY=

# BallDontLie (balldontlie.io) — dados alternativos de NBA
NBA_API_KEY=

# TheSportsDB — "3" = tier gratuito; coloque aqui se tiver chave paga
SPORTS_DB_KEY=3
